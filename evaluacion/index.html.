<style>
/* Layout: banda verde petróleo con el logo, filetes dorados arriba y abajo (como las piezas de Canva), tarjeta crema central de 720px; una consigna por pantalla */
:root{
  color-scheme:light;
  --cream:#f6f3ec; --paper:#fffdf8; --teal:#005753; --teal-2:#1d5b57; --sage:#b0d9ca; --sage-soft:#e4f1ec;
  --gold:#c8a26b; --gold-soft:#f3e9d8; --ink:#1d3b38; --muted:#5f6f6b; --line:#e4dccd; --danger:#a3302b;
  --q-d:#02574f; --q-i:#b2dbcb; --q-s:#74b282; --q-c:#108e86;
  --font:"Arial Nova", Arial, "Helvetica Neue", Helvetica, sans-serif;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{background:var(--cream)}
body{background:var(--cream);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.55;margin:0}
.goldbar{height:10px;background:var(--gold)}
.band{background:var(--teal);color:var(--cream)}
.band-in{max-width:760px;margin:0 auto;padding-block:18px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.band img{height:58px;width:auto;display:block;max-width:100%}
.band .who{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--sage);text-align:right}
.wrap{max-width:760px;margin:0 auto;padding-block:28px 40px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.card{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:28px}
.card+.card{margin-top:18px}
@media (max-width:480px){.card{padding:20px}.band img{height:46px}.band .who{text-align:left}}
h1,h2,h3{margin:0;color:var(--teal-2);font-weight:700;letter-spacing:-.02em;text-wrap:balance}
h1{font-size:30px;line-height:1.12}
h2{font-size:23px;line-height:1.2}
h3{font-size:17px}
p{margin:0}
.rule{width:64px;height:4px;background:var(--gold);border-radius:2px}
.stack{display:flex;flex-direction:column;gap:16px}
.stack-sm{display:flex;flex-direction:column;gap:8px}
.muted{color:var(--muted)}
.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);font-weight:700}
.preview{background:var(--gold-soft);border:1px solid var(--gold);color:var(--ink);border-radius:6px;padding:10px 14px;font-size:14px;margin-bottom:18px}
.progress{height:6px;background:var(--sage-soft);border-radius:4px;overflow:hidden}
.progress>i{display:block;height:100%;background:var(--teal);transition:width .3s}
.meta-row{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);gap:12px;flex-wrap:wrap}
label.field{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:700;color:var(--teal-2)}
input[type=text],input[type=email],textarea,select{font:inherit;font-weight:400;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:4px;padding:11px 12px;width:100%}
textarea{min-height:90px;resize:vertical;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;word-break:break-all}
input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.check{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--ink)}
.check input{margin-top:3px;width:18px;height:18px;accent-color:var(--teal);flex:0 0 auto}
button{font:inherit;cursor:pointer}
.btn{border:0;border-radius:4px;padding:13px 24px;font-weight:700;font-size:13px;letter-spacing:.1em;text-transform:uppercase;background:var(--teal);color:var(--cream)}
.btn:hover{background:var(--teal-2)}
.btn.ghost{background:transparent;color:var(--teal);border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--teal)}
.btn.small{padding:9px 14px;font-size:12px}
.nav{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.err{color:var(--danger);font-size:14px;min-height:20px}
.q{font-size:21px;line-height:1.35;font-weight:700;color:var(--teal-2)}
.hint{font-size:14px;color:var(--muted)}
.opts{display:flex;flex-direction:column;gap:10px}
.opt{display:flex;align-items:center;gap:14px;text-align:left;width:100%;padding:14px 16px;border-radius:6px;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:16px;line-height:1.4}
.opt:hover{border-color:var(--teal)}
.opt .rk{flex:0 0 34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:700;border:1.5px dashed var(--gold);color:var(--gold);font-size:15px}
.opt.on{background:var(--sage-soft);border-color:var(--sage)}
.opt.on .rk{border:0;background:var(--teal);color:var(--cream)}
.legend{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--muted)}
.tri{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px 12px;align-items:center;padding:12px 14px;border:1px solid var(--line);border-radius:6px;background:#fff}
.tri.sel{background:var(--sage-soft);border-color:var(--sage)}
.seg{display:flex;gap:6px}
.seg button{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:4px;padding:8px 13px;font-size:14px;font-weight:700}
.seg button.on{background:var(--teal);border-color:var(--teal);color:var(--cream)}
.seg button.on.less{background:var(--gold);border-color:var(--gold);color:#2b220f}
@media (max-width:480px){.tri{grid-template-columns:1fr}}
.lk{display:flex;flex-direction:column;gap:10px;padding:16px 0;border-top:1px solid var(--line)}
.lk:first-child{border-top:0;padding-top:0}
.lk .scale{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px}
.lk .scale button{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:4px;padding:10px 2px;font-size:13px}
.lk .scale button.on{background:var(--teal);border-color:var(--teal);color:var(--cream);font-weight:700}
.lk.missing .scale button{border-color:var(--danger)}
.codebox{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;background:var(--sage-soft);border-radius:4px;padding:12px;word-break:break-all;user-select:all;color:var(--ink)}
.contact{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 14px;font-size:14px}
.contact span:nth-child(odd){color:var(--muted)}
.center{text-align:center;align-items:center}
.seal{width:88px;height:88px;border-radius:50%;background:var(--teal);display:grid;place-items:center;margin:0 auto}
.seal svg{display:block}
footer.foot{background:var(--teal);color:var(--sage)}
.foot-in{max-width:760px;margin:0 auto;padding-block:22px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px}
.foot .motto{color:var(--cream);font-weight:700;font-size:14px}
.foot-col{display:flex;flex-direction:column;gap:4px;min-width:0}
.foot-name{color:var(--cream)}
.foot-contact{display:grid;grid-template-columns:auto minmax(0,1fr);gap:3px 12px;margin:0;font-size:13px}
.foot-contact dt{color:var(--sage);opacity:.8}
.foot-contact dd{margin:0;color:var(--cream);overflow-wrap:anywhere}
.foot-contact a{color:var(--cream);text-decoration:none;border-bottom:1px solid var(--gold)}
/* informe */
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.kv{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 14px;font-size:14px;margin:0}
.kv dt{color:var(--muted)} .kv dd{margin:0;font-variant-numeric:tabular-nums}
.chart{width:100%;height:auto;display:block;max-width:620px;margin:0 auto}
.alert{padding:12px 14px;border-radius:4px;background:var(--gold-soft);border-left:4px solid var(--gold);font-size:14px}
.ok{padding:12px 14px;border-radius:4px;background:var(--sage-soft);border-left:4px solid var(--teal);font-size:14px}
.alert,.ok{border-radius:0}
.conv{border-left:3px solid var(--gold);padding:4px 0 4px 14px}
.conv .tag{font-size:12px;color:var(--teal);font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.puesto{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
.puesto label{font-size:13px;color:var(--muted);display:flex;flex-direction:column;gap:4px}
.bars{display:flex;flex-direction:column;gap:9px}
.bar{display:grid;grid-template-columns:130px minmax(0,1fr) 34px;gap:10px;align-items:center;font-size:14px}
.bar .t{height:10px;background:var(--sage-soft);border-radius:5px;overflow:hidden}
.bar .t i{display:block;height:100%;border-radius:5px}
.bar b{text-align:right;font-variant-numeric:tabular-nums}
.tabnum{font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="goldbar"></div>
<header class="band"><div class="band-in">
  <img id="logo" alt="Vital Care · Espacio de Evaluaciones Diagnósticas" src="">
  <div class="who">Lic. Noelia B. Poy<br>Evaluaciones diagnósticas</div>
</div></header>
<div class="wrap">
  <div id="previewNote" class="preview" hidden>Vista previa del diseño. En el sistema real, el candidato entra solo con la invitación que le llega por correo, y sus respuestas te llegan solas a vitalcare.evaluaciones@gmail.com.</div>
  <main id="app" aria-live="polite"></main>
</div>
<footer class="foot"><div class="foot-in">
